        <id>dev.agenthive.watch.WatchAppFunctionServiceBase#askHive</id>
        <enabledByDefault>true</enabledByDefault>
        <description>Asks the AgentHive assistant a question and returns the reply.
The query travels over the Nexus mesh to the user's hive cluster,
which answers with the configured agent and model.</description>
        <parameters>
            <dataTypeMetadata>
                <id>unused</id>
                <isNullable>false</isNullable>
                <type>8</type>
            </dataTypeMetadata>
            <id>unused</id>
            <isRequired>true</isRequired>
            <name>query</name>
            <description>the natural-language question or instruction</description>
        </parameters>
        <response>
            <id>unused</id>
            <valueType>
                <id>unused</id>
                <isNullable>false</isNullable>
                <type>8</type>
            </valueType>
        </response>
        <functionId>dev.agenthive.watch.WatchAppFunctionServiceBase#askHive</functionId>
    </appfunction>
