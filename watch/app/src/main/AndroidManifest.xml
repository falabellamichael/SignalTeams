<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" android:required="true" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_EXERCISE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.EXECUTE_APP_FUNCTIONS" />

    <!-- Gemini/Assistant-parity vendor permissions — ignored where signature-only. -->
    <uses-permission android:name="com.samsung.android.watch.timer.permission.READ_TIMER" />
    <uses-permission android:name="com.samsung.android.watch.timer.permission.EDIT_TIMER" />
    <uses-permission android:name="com.samsung.android.watch.alarm.permission.EDIT_ALARM" />
    <uses-permission android:name="com.google.android.wearable.deskclock.permission.READ_PERMISSION" />
    <uses-permission android:name="com.google.android.wearable.deskclock.permission.MUTATE_TIMER" />
    <uses-permission android:name="com.google.android.wearable.deskclock.permission.REMOVE_ALARM" />
    <uses-permission android:name="com.google.wear.permission.READ_FOCUS_MODES" />
    <uses-permission android:name="com.google.wear.permission.WRITE_FOCUS_MODES" />
    <uses-permission android:name="com.google.wear.permission.READ_TOUCH_LOCK" />
    <uses-permission android:name="com.google.wear.permission.WRITE_TOUCH_LOCK" />
    <uses-permission android:name="com.google.wear.permission.READ_BATTERY_SAVER" />
    <uses-permission android:name="com.google.wear.permission.WRITE_BATTERY_SAVER" />
    <uses-permission android:name="com.google.android.wearable.READ_SETTINGS" />
    <uses-permission android:name="com.google.android.wearable.WRITE_SETTINGS" />

    <!-- See other apps' launcher entries for "open <app>" commands. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="dev.agenthive.watch.HiveApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgentHive.Watch">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="dev.agenthive.watch.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.AgentHive.Watch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <action android:name="android.speech.action.WEB_SEARCH" />
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <action android:name="android.search.action.GLOBAL_SEARCH" />
                <action android:name="android.intent.action.START_HOTWORD_QUERY" />
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- screen flashlight — max-brightness white panel, tap to exit -->
        <activity
            android:name="dev.agenthive.watch.device.TorchActivity"
            android:exported="true"
            android:theme="@style/Theme.AgentHive.Watch" />
        <!-- tile-tap trampoline: runs the "action" extra, shows result, exits -->
        <activity
            android:name="dev.agenthive.watch.device.QuickActionActivity"
            android:exported="true"
            android:theme="@style/Theme.AgentHive.Watch" />

        <service
            android:name="dev.agenthive.watch.assist.HiveVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name="dev.agenthive.watch.assist.HiveSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION_SESSION_SERVICE" />

        <service
            android:name="dev.agenthive.watch.assist.HiveRecognitionService"
            android:exported="false"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION" />

        <!-- AppFunctions: exposes askHive + bridge verbs to the system
             assistant — the indexer reads assets/appfunctions.xml via the
             android.app.appfunctions property (Samsung recipe, verified
             on the phone module). -->
        <service
            android:name="dev.agenthive.watch.WatchAppFunctionService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
                <action android:name="android.app.appsearch.functions.AppFunctionService" />
            </intent-filter>
            <property
                android:name="android.app.appfunctions"
                android:value="watch_appfunctions.xml" />
            <meta-data
                android:name="android.app.appfunctions.v2"
                android:resource="@xml/appfunctions" />
        </service>

        <!-- device-control: media transport (needs notification access grant) -->
        <service
            android:name="dev.agenthive.watch.device.HiveNotifService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- device-control: global actions + tap-by-text (needs accessibility grant) -->
        <service
            android:name="dev.agenthive.watch.device.HiveA11y"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/hive_a11y" />
        </service>

        <service
            android:name="dev.agenthive.watch.MeshService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- glanceable tile: hive status + last reply + tap to ask -->
        <service
            android:name="dev.agenthive.watch.tile.HiveTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- quick-controls tile: Ask / torch / find-phone / buzz chips -->
        <service
            android:name="dev.agenthive.watch.tile.HiveControlsTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>

        <!-- watch-face complication: "✦ Ask" / last reply / battery -->
        <service
            android:name="dev.agenthive.watch.complication.HiveComplicationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,RANGED_VALUE" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="600" />
        </service>

        <!-- quick-settings tile: one-tap find-phone in the shade -->
        <service
            android:name="dev.agenthive.watch.qs.HiveQsService"
            android:exported="true"
            android:icon="@drawable/hive_mark"
            android:label="Find phone"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ambient context triggers → proactive suggestions -->
        <receiver android:name="dev.agenthive.watch.device.WatchStopReceiver" android:exported="false">
            <intent-filter>
                <action android:name="dev.agenthive.watch.STOP_FIND" />
            </intent-filter>
        </receiver>
        <receiver android:name="dev.agenthive.watch.device.WatchNotifReceiver" android:exported="false">
            <intent-filter>
                <action android:name="dev.agenthive.watch.OPEN_ON_PHONE" />
                <action android:name="dev.agenthive.watch.REPLY_NOTIF" />
                <action android:name="dev.agenthive.watch.DISMISS_NOTIF" />
            </intent-filter>
        </receiver>
        <receiver android:name="dev.agenthive.watch.ContextReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.HEADSET_PLUG" />
                <action android:name="android.bluetooth.a2dp.profile.action.CONNECTION_STATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- geofence trips → reminder notification -->
        <receiver android:name="dev.agenthive.watch.device.GeoReceiver" android:exported="false" />

        <receiver
            android:name="dev.agenthive.watch.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Wear data-layer listener: phone replies (e.g. /hive/status/reply) -->
        <service
            android:name="dev.agenthive.watch.device.WatchWearService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/hive/" />
            </intent-filter>
        </service>
    </application>
</manifest>
