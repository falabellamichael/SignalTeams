{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignalTeams",
  "version": "1.0.0",
  "identifier": "com.falab.signalteams",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SignalTeams",
        "url": "http://127.0.0.1:8075/",
        "create": false,
        "decorations": false,
        "backgroundColor": "#0d1117",
        "width": 1340,
        "height": 880,
        "minWidth": 820,
        "minHeight": 580,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Falab",
    "category": "Developer Tool",
    "shortDescription": "SignalTeams — your crew's agents",
    "longDescription": "SignalTeams is a local-first team chat built around AI agents: publish, bench and @-summon them in channels, with workspaces, DMs and a local LLM playground.",
    "licenseFile": "msi/license.rtf",
    "icon": ["icons/icon.ico"],
    "resources": {
      "icons/icon.ico": "SignalTeams.ico"
    },
    "windows": {
      "wix": {
        "language": { "en-US": { "localePath": "msi/en-US.wxl" } },
        "upgradeCode": "406ffb1e-1adf-5c17-9a58-a1fb45b35664",
        "bannerPath": "msi/banner_2x.bmp",
        "dialogImagePath": "msi/dialog_2x.bmp"
      }
    }
  }
}
