{
  "identifier": "titlebar",
  "description": "Window controls for the bundled startup page and the local SignalHive workspace.",
  "webviews": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8075/*"]
  },
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging"
  ]
}
